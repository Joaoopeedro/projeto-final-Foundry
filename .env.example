# Variáveis de ambiente — copie para .env e preencha os valores reais

# === MICROSOFT FOUNDRY (AGENTE) ===
PROJECT_ENDPOINT=https://your-foundry-resource.services.ai.azure.com/api/projects/your-project
AGENT_NAME=seu-agente-name

# === AUTENTICAÇÃO AZURE (DefaultAzureCredential) ===
# Opção A: Login via Azure CLI (execute `az login` no terminal)
# Opção B: Service Principal (preencha as 3 variáveis abaixo se preferir)
# AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
# AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# AZURE_CLIENT_SECRET=seu-client-secret-aqui
# Opção C: Token direto (opcional para testes rápidos)
# AZURE_BEARER_TOKEN=seu-bearer-token

# === SERVIDOR ===
PORT=3000
# Origem permitida para CORS (use o domínio real em produção, ex: https://duarteadvocacia.com.br)
ALLOWED_ORIGIN=http://localhost:3000

# === ESCRITÓRIO ===
OFFICE_NAME=Duarte Advocacia
OFFICE_EMAIL=contato@duarteadvocacia.com.br
# Número do WhatsApp no formato internacional sem espaços (ex: 5511999999999)
WHATSAPP_NUMBER=5511999999999
OAB_REGISTER=OAB/SP 000000
